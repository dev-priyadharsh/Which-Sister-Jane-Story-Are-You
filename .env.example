# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these in the Vercel dashboard instead:
# Project -> Settings -> Environment Variables.

GEMINI_API_KEY=your_key_here

# Optional. Lets you swap models later without touching code.
# Google renames/deprecates Gemini model IDs fairly often — check
# https://ai.google.dev/gemini-api/docs/models for the current name
# if this one stops working.
GEMINI_MODEL=gemini-3.1-flash-lite
